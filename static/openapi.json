            "description": "Mã trạm"
          },
          {
            "name": "pollutant",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Chỉ số quan trắc (pm25, pm10, no2, co, o3, so2)",
              "default": "pm25",
              "title": "Pollutant"
            },
            "description": "Chỉ số quan trắc (pm25, pm10, no2, co, o3, so2)"
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 168,
              "minimum": 6,
              "description": "Số giờ lịch sử cần lấy (6 đến 168 giờ)",

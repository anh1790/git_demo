  "components": {
    "schemas": {
      "ForecastRequest": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id",
            "description": "Mã trạm quan trắc (ví dụ: VN_HN, VN_DN, VN_HCM)",
            "default": "VN_HN"
          },
          "pollutant": {
            "type": "string",
            "title": "Pollutant",
            "description": "Chỉ số dự báo (mặc định: pm25)",
            "default": "pm25"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name",
            "description": "Mô hình AI sử dụng (Baseline, Random_Forest, Neural_Network, Random_Forest_Quantized, Neural_Network_Quantized)",
            "default": "Random_Forest"
          },
          "horizon_hours": {
            "type": "integer",
            "maximum": 48.0,
            "minimum": 1.0,
            "title": "Horizon Hours",
            "description": "Số giờ cần dự báo (1 đến 48 giờ)",
            "default": 48
          }
        },
        "type": "object",
        "title": "ForecastRequest"
      },
      "ForecastResponse": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "station_name": {
            "type": "string",
            "title": "Station Name"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "model_used": {
            "type": "string",
            "title": "Model Used"
          },
          "horizon_hours": {
            "type": "integer",
            "title": "Horizon Hours"
          },
          "current_timestamp": {
            "type": "string",
            "title": "Current Timestamp"
          },
          "current_pm25": {
            "type": "number",
            "title": "Current Pm25"
          },
          "forecast_steps": {
            "items": {
              "$ref": "#/components/schemas/ForecastStepResult"
            },
            "type": "array",
            "title": "Forecast Steps"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Kết quả dự báo từ mô hình AI phục vụ học tập và nghiên cứu, không thay thế trạm đo quốc gia."
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "station_name",
          "district",
          "model_used",
          "horizon_hours",
          "current_timestamp",
          "current_pm25",
          "forecast_steps"
        ],
        "title": "ForecastResponse"
      },
      "ForecastStepResult": {
        "properties": {
          "step_ahead": {
            "type": "integer",
            "title": "Step Ahead"
          },
          "forecast_time": {
            "type": "string",
            "title": "Forecast Time"
          },
          "pm25_predicted": {
            "type": "number",
            "title": "Pm25 Predicted"
          },
          "lower_bound": {
            "type": "number",
            "title": "Lower Bound"
          },
          "upper_bound": {
            "type": "number",
            "title": "Upper Bound"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "aqi_level": {
            "type": "string",
            "title": "Aqi Level"
          },
          "aqi_code": {
            "type": "string",
            "title": "Aqi Code"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "health_advice": {
            "type": "string",
            "title": "Health Advice"
          }
        },
        "type": "object",
        "required": [
          "step_ahead",
          "forecast_time",
          "pm25_predicted",
          "lower_bound",
          "upper_bound",
          "unit",
          "aqi_level",
          "aqi_code",
          "color",
          "health_advice"
        ],
        "title": "ForecastStepResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "example": "healthy"
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds"
          },
          "cpu_percent": {
            "type": "number",
            "title": "Cpu Percent"
          },
          "memory_mb": {
            "type": "number",
            "title": "Memory Mb"
          },
          "models_loaded": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models Loaded"
          },
          "stations_count": {
            "type": "integer",
            "title": "Stations Count"
          },
          "districts_count": {
            "type": "integer",
            "title": "Districts Count"
          }
        },
        "type": "object",
        "required": [
          "status",
          "uptime_seconds",
          "cpu_percent",
          "memory_mb",
          "models_loaded",
          "stations_count",
          "districts_count"
        ],
        "title": "HealthResponse"
      },
